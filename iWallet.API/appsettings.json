{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "app-log/logs-.txt",
          "rollingInterval": "Day"
        }
      },

      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }

      }
    ],
    "Enrich": ["FromLogContext", "WithThreadId", "WithMachineName"]
  },
 
  "AllowedHosts": "*"
}
