{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.OpenTelemetry" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "app-log/logs-.txt",
          "rollingInterval": "Day"
        }
      },

      {
        "Name": "OpenTelemetry",
        "Args": {
          "ResourceAttributes": {
            "service.name": "iWallet"
          }
        }
      }
    ]
  },

  //to prevent kubernetes DB Connection issue,   in futuer will deploy StatefulSet
    "Database": {
      "Enabled": true
    },
  
 
  "AllowedHosts": "*"
}
