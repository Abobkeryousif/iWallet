{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "app-log/logs-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "Endpoint": "http://otel-collector:4317",
          "Protocol": "Grpc",
          "ResourceAttributes": {
            "service.name": "iWallet",
            "service.version": "2.0"
          }
        }
      }
    ]
  },
  "Database": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
