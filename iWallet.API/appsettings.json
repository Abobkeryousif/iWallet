{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.OpenTelemetry" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "app-log/logs-.txt",
          "rollingInterval": "Day"
        }
      },

      {
        "Name": "OpenTelemetry",
        "Args": {
          "ResourceAttributes": {            "service.name":  "iWallet"
          }
        }
      }
    ]
  },
 
  "AllowedHosts": "*"
}
